# Runtime state. Menu settings, the prompt and voice commands are tracked so the app
# moves with a clone; keys, recordings, dictation text, built binaries, the wake venv
# and the machine-specific mic are not.
state/*
!state/model
!state/lang
!state/output
!state/enter
!state/wake
!state/wake-model
!state/prompt
!state/actions.lua

# Model comparison harness — intermediate WAVs only
tests/model-comparison/tmp/